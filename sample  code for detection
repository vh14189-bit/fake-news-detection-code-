import csv
from collections import Counter

# Load dataset
training_data = []
try:
    with open("news_dataset.csv", newline='', encoding='utf-8') as f:
        reader = csv.DictReader(f)
        for row in reader:
            if "text" in row and "label" in row:
                training_data.append((row["text"], row["label"]))
except FileNotFoundError:
    training_data = []

# Build a simple keyword-based classifier
keyword_counts = {}
for text, label in training_data:
    words = [w.strip(".,!?;:\"'()[]").lower() for w in text.split()]
    for word in words:
        if len(word) < 3:
            continue
        keyword_counts.setdefault(word, Counter())[label] += 1

if keyword_counts:
    def predict(news_text):
        words = [w.strip(".,!?;:\"'()[]").lower() for w in news_text.split()]
        score = Counter()
        for word in words:
            if word in keyword_counts:
                score.update(keyword_counts[word])
        return score.most_common(1)[0][0] if score else "unknown"
else:
    def predict(news_text):
        suspicious = {"free", "microchips", "aliens", "lottery", "urgent", "fake"}
        words = [w.strip(".,!?;:\"'()[]").lower() for w in news_text.split()]
        return "fake" if any(word in suspicious for word in words) else "real"

news = input("Enter News: ")
result = predict(news)
print("\nPrediction:", result)

